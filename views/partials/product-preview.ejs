<%# ProductPreview: the Voult console for one app. Fields mirror the real models
    (EndUser, RefreshToken, App, AuditLog). All data is sample data. %>
<%
const views = [
  ['overview', 'dashboard', 'Overview'],
  ['users', 'users', 'Users'],
  ['sessions', 'refresh', 'Sessions'],
  ['methods', 'key', 'Sign-in methods'],
  ['security', 'shield', 'Security'],
  ['keys', 'lock', 'API keys'],
];
const users = [
  ['Ada Okafor', 'ada@example.com', 'Password', true, true, '2 min ago', 'active'],
  ['Sam Rivera', 'sam@example.com', 'Google', true, false, '14 min ago', 'active'],
  ['Mei Tanaka', 'mei@example.com', 'Passkey', true, true, '1 h ago', 'active'],
  ['Kofi Mensah', 'kofi@example.com', 'Magic link', true, false, '3 h ago', 'active'],
  ['Lin Chen', 'lin@example.com', 'GitHub', true, true, 'Yesterday', 'active'],
  ['Priya Nair', 'priya@example.com', 'Password', true, false, '2 d ago', 'locked'],
  ['Jonas Weber', 'jonas@example.com', 'Password', false, false, 'Never', 'unverified'],
];
const events = [
  ['14:22', 'LOGIN_SUCCESS', 'ada@example.com', 'low'],
  ['14:22', 'SESSION_CREATED', 'ada@example.com', 'low'],
  ['14:18', 'TOKEN_REVOKED', 'lin@example.com', 'critical', 'Refresh token reuse detected, all sessions revoked'],
  ['14:09', 'PASSWORD_RESET', 'kofi@example.com', 'high'],
  ['14:02', 'ACCOUNT_LOCKED', 'priya@example.com', 'medium', '5 failed password attempts'],
];
const providers = [['Google', true], ['GitHub', true], ['Microsoft', true], ['Apple', false], ['Facebook', false], ['LinkedIn', false]];
%>
<div class="console" role="region" aria-label="Preview of the Voult dashboard for one app, using sample data" id="product">
  <div class="console-bar">
    <div class="console-app">
      <span class="console-mark" aria-hidden="true"><svg width="14" height="12" viewBox="5 8 22 17"><path d="M6 9 L12 24 H14.2 L8.2 9 H6Z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M17.8 9 L23.8 24 H26 L20 9 H17.8Z" fill="currentColor"/></svg></span>
      <span class="mono muted">acme</span><span class="console-sep" aria-hidden="true">/</span><span class="mono console-app-name">acme-web</span>
      <span class="pill pill-ok"><span class="status-dot"></span>Active</span>
    </div>
    <span class="badge badge-preview">Preview · sample data</span>
  </div>

  <div class="console-body">
    <div class="console-nav" role="tablist" aria-label="Dashboard views" aria-orientation="vertical">
      <% views.forEach(([id, icon, label], i) => { %>
        <button type="button" role="tab" id="cv-tab-<%= id %>" aria-controls="cv-<%= id %>" aria-selected="<%= i === 0 %>" tabindex="<%= i === 0 ? 0 : -1 %>">
          <%- include('icon', { name: icon, size: 15 }) %><span><%= label %></span>
        </button>
      <% }) %>
    </div>

    <div class="console-main">
      <section class="cv" role="tabpanel" id="cv-overview" aria-labelledby="cv-tab-overview">
        <header class="cv-head">
          <h3>Overview</h3>
          <p>Created Sep 2, 2026 · Cookie sessions</p>
        </header>
        <div class="cv-stats">
          <div><span>Users</span><strong class="mono">1,284</strong><small>total registrations</small></div>
          <div><span>Logins</span><strong class="mono">9,730</strong><small>all time</small></div>
          <div><span>Sign-in methods</span><strong class="mono">6</strong><small>enabled</small></div>
        </div>
        <div class="cv-split">
          <div class="cv-block">
            <h4>Recent activity</h4>
            <ul class="cv-feed">
              <% events.forEach(([t, ev, user, risk]) => { %>
                <li><span class="risk-dot risk-<%= risk %>" aria-hidden="true"></span><code><%= ev %></code><span class="muted cv-feed-user"><%= user %></span><span class="mono muted"><%= t %></span></li>
              <% }) %>
            </ul>
          </div>
          <div class="cv-block">
            <h4>Enabled methods</h4>
            <ul class="cv-enabled">
              <% ['Email + password', 'Magic links', 'Passkeys', 'Google', 'GitHub', 'Microsoft'].forEach((m) => { %>
                <li><%- include('icon', { name: 'check', size: 13 }) %><%= m %></li>
              <% }) %>
            </ul>
          </div>
        </div>
      </section>

      <section class="cv" role="tabpanel" id="cv-users" aria-labelledby="cv-tab-users" hidden>
        <header class="cv-head">
          <h3>Users</h3>
          <span class="cv-search">Search by email or username</span>
        </header>
        <div class="cv-table-wrap">
          <table class="cv-table">
            <thead><tr><th>User</th><th class="hide-xs">Method</th><th class="hide-sm">Verified</th><th class="hide-sm">MFA</th><th class="hide-sm">Last login</th><th>Status</th></tr></thead>
            <tbody>
              <% users.forEach(([name, email, method, verified, mfa, last, status]) => { %>
                <tr>
                  <td><span class="cv-user"><span class="avatar" aria-hidden="true"><%= name.split(' ').map((w) => w[0]).join('') %></span><span><%= name %><small><%= email %></small></span></span></td>
                  <td class="hide-xs"><span class="tag"><%= method %></span></td>
                  <td class="hide-sm"><%= verified ? 'Yes' : 'No' %></td>
                  <td class="hide-sm"><%= mfa ? 'TOTP' : 'Off' %></td>
                  <td class="muted hide-sm"><%= last %></td>
                  <td><span class="state state-<%= status %>"><%= { active: 'Active', locked: 'Locked', unverified: 'Unverified' }[status] %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="cv" role="tabpanel" id="cv-sessions" aria-labelledby="cv-tab-sessions" hidden>
        <header class="cv-head">
          <h3>Sessions</h3>
          <p>Refresh tokens rotate on every use.</p>
        </header>
        <div class="cv-table-wrap">
          <table class="cv-table">
            <thead><tr><th>User</th><th>Device</th><th class="hide-sm">IP address</th><th>Last used</th><th class="hide-sm">Expires</th><th><span class="sr-only">Actions</span></th></tr></thead>
            <tbody>
              <% [
                ['ada@example.com', 'Chrome · macOS', '203.0.113.24', '2 min ago', 'in 7 days'],
                ['sam@example.com', 'Safari · iOS', '203.0.113.61', '14 min ago', 'in 7 days'],
                ['mei@example.com', 'Firefox · Linux', '192.0.2.14', '1 h ago', 'in 6 days'],
                ['kofi@example.com', 'Edge · Windows', '198.51.100.33', '3 h ago', 'in 6 days'],
                ['lin@example.com', 'Chrome · Android', '198.51.100.7', 'Revoked', 'Reuse detected'],
              ].forEach(([user, ua, ip, last, exp]) => { const revoked = last === 'Revoked'; %>
                <tr>
                  <td><%= user %></td>
                  <td class="muted"><%= ua %></td>
                  <td class="mono muted hide-sm"><%= ip %></td>
                  <td class="<%= revoked ? 'text-bad' : 'muted' %>"><%= last %></td>
                  <td class="muted hide-sm"><%= exp %></td>
                  <td class="cv-right"><% if (!revoked) { %><span class="mini-btn mini-btn-danger">Revoke</span><% } %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="cv" role="tabpanel" id="cv-methods" aria-labelledby="cv-tab-methods" hidden>
        <header class="cv-head">
          <h3>Sign-in methods</h3>
          <p>Enabled per app. Users can link several to one account.</p>
        </header>
        <div class="cv-methods-grid">
          <div class="cv-block">
            <h4>Passwords &amp; passwordless</h4>
            <% [['Email + password', true], ['Username + password', false], ['Magic links', true], ['Passkeys (WebAuthn)', true]].forEach(([m, on]) => { %>
              <div class="cv-toggle-row"><span><%= m %></span><span class="switch <%= on ? 'is-on' : '' %>" role="img" aria-label="<%= on ? 'On' : 'Off' %>"></span></div>
            <% }) %>
          </div>
          <div class="cv-block">
            <h4>OAuth providers</h4>
            <% providers.forEach(([p, on]) => { %>
              <div class="cv-toggle-row"><span><%= p %><% if (!on) { %> <small>not configured</small><% } %></span><span class="switch <%= on ? 'is-on' : '' %>" role="img" aria-label="<%= on ? 'On' : 'Off' %>"></span></div>
            <% }) %>
          </div>
        </div>
        <p class="cv-foot mono">Redirect URI · https://api.voult.dev/api/oauth/&lt;provider&gt;/callback</p>
      </section>

      <section class="cv" role="tabpanel" id="cv-security" aria-labelledby="cv-tab-security" hidden>
        <header class="cv-head">
          <h3>Security</h3>
          <p>Policies and audit trail for this app.</p>
        </header>
        <div class="cv-policies">
          <% [
            ['Account lockout', '5 failed attempts'],
            ['Multi-factor auth', 'TOTP + backup codes'],
            ['Access tokens', '15 min lifetime'],
            ['IP allowlist', 'Alert on new IPs'],
          ].forEach(([k, v]) => { %>
            <div><span><%= k %></span><strong><%= v %></strong></div>
          <% }) %>
        </div>
        <div class="cv-table-wrap">
          <table class="cv-table">
            <thead><tr><th>Time</th><th>Event</th><th class="hide-sm">User</th><th>Risk</th></tr></thead>
            <tbody>
              <% events.forEach(([t, ev, user, risk, note]) => { %>
                <tr>
                  <td class="mono muted"><%= t %></td>
                  <td><code><%= ev %></code><% if (note) { %><small class="cv-note"><%= note %></small><% } %></td>
                  <td class="muted hide-sm"><%= user %></td>
                  <td><span class="risk risk-<%= risk %>"><%= risk %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="cv" role="tabpanel" id="cv-keys" aria-labelledby="cv-tab-keys" hidden>
        <header class="cv-head">
          <h3>API keys</h3>
          <p>Server-side only. Never ship these to the browser.</p>
        </header>
        <dl class="cv-keys">
          <div><dt>Client ID</dt><dd><code>app_7f3c9e21b4d8a6</code></dd></div>
          <div><dt>Client secret</dt><dd><span class="muted">Stored hashed. Shown once when created or rotated.</span><span class="mini-btn">Rotate secret</span></dd></div>
          <div><dt>Callback URLs</dt><dd><code>https://acme.example/auth/callback</code><code>http://localhost:5173/magic-callback</code></dd></div>
        </dl>
        <pre class="cv-env"><span class="muted"># .env written by `npx voult init`</span>
VOULT_CLIENT_ID=app_7f3c9e21b4d8a6
VOULT_CLIENT_SECRET=<span class="muted">••••••••••••••••</span>
VOULT_SESSION_SECRET=<span class="muted">(generated, 32 bytes)</span></pre>
      </section>
    </div>
  </div>
</div>
