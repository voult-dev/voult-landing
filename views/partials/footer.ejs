<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <%- include('logo') %>
        <p>Authentication infrastructure for Node.js developers — sign-in, sessions and security controls you don't have to build yourself.</p>
      </div>

      <nav class="footer-col" aria-label="Product">
        <h2>Product</h2>
        <a href="/#features">Features</a>
        <a href="/#pricing">Pricing</a>
        <% if (site.playgroundUrl) { %><a href="<%= site.playgroundUrl %>" target="_blank" rel="noopener">Playground</a>
        <% } else { %><span aria-disabled="true">Playground <span class="badge badge-sm">Soon</span></span><% } %>
        <a href="<%= site.docsUrl %>" target="_blank" rel="noopener">Docs</a>
      </nav>

      <nav class="footer-col" aria-label="Developers">
        <h2>Developers</h2>
        <a href="<%= site.docsUrl %>" target="_blank" rel="noopener">API reference</a>
        <a href="<%= site.npmUrl('@voult/sdk') %>" target="_blank" rel="noopener">SDK</a>
        <a href="<%= site.npmUrl('@voult/express') %>" target="_blank" rel="noopener">Express router</a>
        <a href="<%= site.npmUrl('@voult/cli') %>" target="_blank" rel="noopener">CLI</a>
        <a href="<%= site.githubUrl %>" target="_blank" rel="noopener">GitHub</a>
      </nav>

      <nav class="footer-col" aria-label="Company">
        <h2>Company</h2>
        <a href="/about">About</a>
        <a href="/contact-us">Contact</a>
        <a href="/privacy-policy">Privacy</a>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>© <%= new Date().getFullYear() %> voult.dev</p>
      <p class="mono"><span class="status-dot" aria-hidden="true"></span> In active development</p>
    </div>
  </div>
</footer>
