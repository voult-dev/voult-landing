<form class="waitlist" id="waitlist-form" novalidate>
  <label for="waitlist-email" class="sr-only">Work email</label>
  <input id="waitlist-email" name="email" type="email" autocomplete="email" placeholder="you@company.dev" required maxlength="255">
  <button id="waitlist-submit" type="submit" class="btn btn-primary">Join the waitlist</button>
  <p id="waitlist-msg" class="waitlist-msg" role="status" aria-live="polite"></p>
</form>
