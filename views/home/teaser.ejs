<% layout('layout/boilerplate.ejs') %>

<main>
  <section class="container" style="padding-top: 5rem; padding-bottom: 5rem;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <img src="/images/logo.png" alt="voult.dev logo" style="height: 48px; width: auto;">
    </div>

    <h1 style="text-align: center; font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; letter-spacing: -0.03em; margin: 0 0 1.25rem;">
      Authentication,<br />
      <span class="grad">done properly.</span>
    </h1>

    <p style="max-width: 640px; margin: 0 auto 3rem; color: var(--muted); font-size: 1.15rem; line-height: 1.7; text-align: center;">
      voult.dev is a developer-first authentication platform — secure APIs, lightweight SDKs, OAuth, magic links, JWT handling, and pre-built UI kits. Skip the auth grind. Ship the product.
    </p>

    <div class="features-grid" style="max-width: 960px; margin: 0 auto;">

      <article class="feature">
        <div class="feature-icon">&#128704;</div>
        <h3>Security-first</h3>
        <p>Bcrypt password hashing, JWT + refresh rotation, CSRF protection, rate limiting, and helmet headers — wired in by default.</p>
      </article>

      <article class="feature">
        <div class="feature-icon">&#128230;</div>
        <h3>Lightweight SDK &amp; docs</h3>
        <p>Tiny, typed SDKs with zero runtime bloat. Clear docs, real examples, copy-pasteable snippets — no marketing fluff.</p>
      </article>

      <article class="feature">
        <div class="feature-icon">&#9889;</div>
        <h3>Smooth DX, easy integration</h3>
        <p>Drop voult into an existing Express, Next, or Vite app in minutes. Sensible defaults, escape hatches when you need them.</p>
      </article>

      <article class="feature">
        <div class="feature-icon">&#128202;</div>
        <h3>Rich developer portal</h3>
        <p>Interactive dashboard + CLI showing live metrics — sign-up rates, failed logins, token usage, OAuth provider breakdown.</p>
      </article>

      <article class="feature">
        <div class="feature-icon">&#127881;</div>
        <h3>Free at launch</h3>
        <p>No credit card. No debit card. No trial. Use the entire MVP for free while we build out advanced features.</p>
      </article>

      <article class="feature">
        <div class="feature-icon">&#127912;</div>
        <h3>Pre-built UI kits</h3>
        <p>Drop-in login &amp; register components tailored to your stack — React, Vue, Svelte, plain HTML. Themed, accessible, yours to fork.</p>
      </article>

    </div>
  </section>
</main>
