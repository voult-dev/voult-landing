<% layout('layout/boilerplate.ejs') %>
<%
// `code` spans inside content strings → <code>
const md = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
const ARROW = include('../partials/icon', { name: 'arrow', size: 16 });
%>

<%- include('../partials/nav') %>

<main id="main">
  <!-- Hero: what it is, why it matters, what to do next. The console carries the weight. -->
  <section class="hero">
    <div class="container">
      <a class="release" href="#roadmap">
        <span class="release-tag mono">Pre-release</span>
        <span>In active development · <%= site.launchLabel ? `Launching ${site.launchLabel}` : 'Launch date to be announced' %></span>
        <%- include('../partials/icon', { name: 'arrow', size: 14 }) %>
      </a>

      <div class="hero-head">
        <h1>Authentication infrastructure you don’t have to build.</h1>
        <div class="hero-side">
          <p class="lede">
            Voult is a hosted auth API for Node.js. Sign-up, login, sessions, OAuth, MFA and passkeys
            run on Voult. Your Express app mounts one router and gets back to its own features.
          </p>
          <div class="hero-actions">
            <% if (site.waitlistOpen) { %>
              <a href="#start" class="btn btn-primary">Get early access <%- ARROW %></a>
            <% } else { %>
              <a href="#quickstart" class="btn btn-primary">Get started <%- ARROW %></a>
            <% } %>
            <a href="#how" class="btn btn-secondary">How it works</a>
          </div>
        </div>
      </div>

      <%- include('../partials/product-preview') %>
      <p class="console-caption">Every field above maps to Voult’s data model. The values are sample data, and some of these views are still being built.</p>
    </div>
  </section>

  <!-- 01 Why -->
  <section class="section" id="why">
    <div class="container">
      <p class="label"><span>01</span>Why Voult</p>
      <div class="why-grid">
        <div class="reveal">
          <h2>Login is the smallest feature with the largest attack surface.</h2>
          <p class="section-lede">
            A sign-in form needs password hashing, token signing, refresh rotation, lockout, email flows,
            an OAuth callback per provider and an audit trail. Each piece is security-critical, and none
            of it is your product.
          </p>
        </div>

        <div class="compare reveal">
          <div class="compare-col">
            <p class="compare-title"><span>Built in-house</span><span class="mono muted"><%= inHouse.length %> modules to write, test and patch</span></p>
            <ul class="tree mono">
              <% inHouse.forEach((f) => { %><li><%= f %></li><% }) %>
            </ul>
          </div>
          <div class="compare-col compare-voult">
            <p class="compare-title"><span>With Voult</span><span class="mono muted">1 router</span></p>
            <pre class="compare-code"><code><span class="tk-f">app.use</span>(<span class="tk-s">'/api/auth'</span>,
  <span class="tk-f">createVoultRouter</span>());</code></pre>
            <p class="compare-note">The same flows, served by Voult. Security fixes ship in the API, not in your codebase.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 How it works -->
  <section class="section section-alt" id="how">
    <div class="container">
      <p class="label"><span>02</span>How it works</p>
      <div class="section-head reveal">
        <h2>Your users talk to your server. Your server talks to Voult.</h2>
        <p class="section-lede">
          <code>@voult/express</code> runs inside your app and holds the client secret. The browser only ever sees
          httpOnly cookies. Here is a password login, end to end.
        </p>
      </div>

      <div class="seq reveal" role="img" aria-label="Login sequence: the browser posts credentials to your server, your server authenticates to the Voult API with its client ID and secret, Voult verifies the user and returns tokens, and your server sets httpOnly cookies.">
        <div class="seq-lanes" aria-hidden="true">
          <div><strong>Browser</strong><span>your frontend</span></div>
          <div><strong>Your server</strong><span class="mono">@voult/express</span></div>
          <div><strong>Voult API</strong><span>users, tokens, policy</span></div>
        </div>
        <ol class="seq-steps" aria-hidden="true">
          <% loginFlow.forEach((s, i) => {
               const lanes = ['Browser', 'Your server', 'Voult API'];
               const a = s.at !== undefined ? s.at : Math.min(s.from, s.to);
               const b = s.at !== undefined ? s.at : Math.max(s.from, s.to);
               const dir = s.at !== undefined ? 'self' : (s.to > s.from ? 'right' : 'left'); %>
            <li class="seq-step seq-<%= dir %>" style="--a: <%= a %>; --b: <%= b %>">
              <span class="seq-n mono"><%= i + 1 %></span>
              <span class="seq-route mono"><%= s.at !== undefined ? lanes[s.at] : `${lanes[s.from]} → ${lanes[s.to]}` %></span>
              <span class="seq-label"><%= s.label %></span>
              <% if (s.note) { %><span class="seq-note"><%= s.note %></span><% } %>
            </li>
          <% }) %>
        </ol>
      </div>
    </div>
  </section>

  <!-- 03 Capabilities -->
  <section class="section" id="capabilities">
    <div class="container">
      <p class="label"><span>03</span>What’s included</p>
      <div class="section-head reveal">
        <h2>What Voult handles today, and what’s still coming.</h2>
        <p class="legend mono">
          <span><i class="st st-available"></i>Available</span>
          <span><i class="st st-in-progress"></i>In progress</span>
          <span><i class="st st-planned"></i>Planned</span>
        </p>
      </div>

      <% capabilities.forEach((g) => { %>
        <div class="cap reveal" id="cap-<%= g.id %>">
          <div class="cap-intro">
            <h3><%= g.title %></h3>
            <p><%= g.body %></p>
          </div>
          <div class="cap-content">
            <ul class="cap-list">
              <% g.items.forEach(([name, detail, status]) => { const k = status.toLowerCase().replace(' ', '-'); %>
                <li class="cap-item is-<%= k %>">
                  <i class="st st-<%= k %>" aria-hidden="true"></i>
                  <div><strong><%- md(name) %></strong><span><%- md(detail) %></span></div>
                  <% if (status !== 'Available') { %><span class="cap-status mono"><%= status %></span><% } else { %><span class="sr-only">Available</span><% } %>
                </li>
              <% }) %>
            </ul>

            <% if (g.id === 'sessions') { %>
              <figure class="rotation">
                <figcaption class="mono">Refresh-token rotation</figcaption>
                <div class="rotation-row">
                  <span class="tok">rt_A</span><span class="rot-arrow" aria-hidden="true"></span><span class="tok">rt_B</span><span class="rot-arrow" aria-hidden="true"></span><span class="tok tok-live">rt_C</span>
                  <span class="rot-note">each refresh returns a new token and retires the old one</span>
                </div>
                <div class="rotation-row rotation-bad">
                  <span class="tok tok-bad">rt_A</span><span class="rot-arrow" aria-hidden="true"></span><span class="tok tok-bad">401</span>
                  <span class="rot-note">a retired token is replayed: every session for that user is revoked, audit risk <b>CRITICAL</b></span>
                </div>
              </figure>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- 04 Get started -->
  <section class="section section-alt" id="quickstart">
    <div class="container">
      <p class="label"><span>04</span>Get started</p>
      <div class="dx-grid">
        <div class="dx-copy reveal">
          <h2>What using Voult looks like.</h2>
          <p class="section-lede">No auth routes to write. Mount the router, and your frontend calls your own <code>/api/auth</code> endpoints.</p>

          <ol class="steps">
            <li><span class="step-n mono">1</span><div><strong>Create an app</strong><p>The dashboard gives you a client ID and a secret, shown once.</p></div></li>
            <li>
              <span class="step-n mono">2</span>
              <div>
                <strong>Install and run <code>npx voult init</code></strong>
                <p>Writes <code>.env</code> (mode 0600) and <code>.env.example</code>, and generates your session secret.</p>
                <div class="install" data-code>
                  <pre class="code-panel"><code><%= install %></code></pre>
                  <button type="button" class="icon-btn code-copy" data-copy aria-label="Copy install command">
                    <span class="copy-idle"><%- include('../partials/icon', { name: 'copy', size: 14 }) %></span>
                    <span class="copy-done"><%- include('../partials/icon', { name: 'check', size: 14 }) %></span>
                  </button>
                </div>
              </div>
            </li>
            <li><span class="step-n mono">3</span><div><strong>Mount the router</strong><p>Your app now serves these routes:</p>
              <div class="routes" aria-label="Routes provided by createVoultRouter">
                <% routes.forEach(([m, p]) => { %>
                  <span class="route"><span class="method method-<%= m.toLowerCase() %>"><%= m %></span><code><%= p %></code></span>
                <% }) %>
              </div>
            </div></li>
          </ol>
          <p class="works-with">Works with Node.js and Express 4 or 5. Any frontend that can call <code>fetch</code> works too; the Voult playground is built with React and Vite.</p>
        </div>

        <div class="dx-code reveal">
          <%- include('../partials/code-block', { id: 'qs', label: 'Integration examples', tabs: quickstart }) %>
          <p class="caption">Real <code>@voult/express</code> and <code>@voult/sdk</code> APIs, as published on npm.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Road to launch -->
  <section class="section" id="roadmap">
    <div class="container">
      <p class="label"><span>05</span>Road to launch</p>
      <div class="section-head reveal">
        <h2>Voult isn’t public yet. Here is where it stands.</h2>
        <p class="section-lede">
          <% if (site.waitlistOpen) { %>
            Public launch is planned for <%= site.launchLabel %>. The waitlist is open, and members get access first.
          <% } else { %>
            The launch date isn’t set yet. The waitlist opens the day it is.
          <% } %>
        </p>
      </div>
      <ol class="roadmap reveal">
        <% roadmap.forEach((r) => { %>
          <li class="road-<%= r.stage.toLowerCase().replace(' ', '-') %>">
            <p class="road-stage mono"><i aria-hidden="true"></i><%= r.stage %></p>
            <ul><% r.items.forEach((it) => { %><li><%- md(it) %></li><% }) %></ul>
          </li>
        <% }) %>
      </ol>
    </div>
  </section>

  <!-- 06 Pricing -->
  <section class="section section-alt" id="pricing">
    <div class="container">
      <p class="label"><span>06</span>Pricing</p>
      <div class="pricing reveal">
        <div>
          <h2>Pricing is published before launch.</h2>
          <p class="section-lede">We won’t list plans until they’re final. Questions about pricing or volume can come to us directly.</p>
          <a href="/contact-us" class="text-link">Contact us <%- include('../partials/icon', { name: 'arrow', size: 14 }) %></a>
        </div>
        <dl class="pricing-table">
          <div><dt>Early access</dt><dd><%= site.waitlistOpen ? 'Open now through the waitlist' : 'Opens with the launch date' %></dd></div>
          <div><dt>Included</dt><dd>The full auth API, the three npm packages, the dashboard and audit log</dd></div>
          <div><dt>Launch plans</dt><dd>Announced before public launch, to early-access members first</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Next step -->
  <section class="section cta" id="start">
    <div class="container cta-inner reveal">
      <div class="cta-copy">
        <h2>Stop maintaining login code.</h2>
        <% if (site.waitlistOpen) { %>
          <p>Join the waitlist for access before launch. We’ll send one confirmation email now and reach out when access opens.</p>
        <% } else { %>
          <p>Voult is in active development. The waitlist opens as soon as the launch date is set. Until then, the packages are on npm and we’re happy to talk.</p>
        <% } %>
      </div>
      <div class="cta-form">
        <% if (site.waitlistOpen) { %>
          <%- include('../partials/waitlist-form') %>
        <% } else { %>
          <div class="cta-actions">
            <a href="/contact-us" class="btn btn-primary">Contact us <%- ARROW %></a>
            <a href="<%= site.githubUrl %>" class="btn btn-secondary" target="_blank" rel="noopener"><%- include('../partials/icon', { name: 'github', size: 15 }) %>GitHub</a>
          </div>
        <% } %>
        <p class="cta-links">
          <% ['@voult/sdk', '@voult/express', '@voult/cli'].forEach((p) => { %>
            <a href="<%= site.npmUrl(p) %>" target="_blank" rel="noopener" class="mono"><%= p %> <%- include('../partials/icon', { name: 'external', size: 12 }) %></a>
          <% }) %>
          <% if (site.docsUrl) { %><a href="<%= site.docsUrl %>" target="_blank" rel="noopener">Docs <%- include('../partials/icon', { name: 'external', size: 12 }) %></a><% } %>
          <% if (site.playgroundUrl) { %><a href="<%= site.playgroundUrl %>" target="_blank" rel="noopener">Playground <%- include('../partials/icon', { name: 'external', size: 12 }) %></a><% } %>
        </p>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
