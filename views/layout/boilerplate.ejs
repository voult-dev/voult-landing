<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= title %></title>
    <meta name="description" content="Voult is a developer-first authentication platform for Node.js: passwords, OAuth, magic links, MFA, passkeys and sessions behind one Express router and a JavaScript SDK.">
    <meta property="og:title" content="Voult | Authentication you mount, not maintain">
    <meta property="og:description" content="Developer-first authentication for Node.js. Currently in development.">
    <meta property="og:type" content="website">
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0b0c0e" media="(prefers-color-scheme: dark)">
    <script>
      // Runs before paint so the saved/system theme is applied without a flash.
      (function () {
        var t;
        try { t = localStorage.getItem('voult-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/images/favicon.svg">
    <link rel="stylesheet" href="/css/landing.css?v=6">
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <%- body %>
    <script src="/js/site.js?v=6" defer></script>
</body>
</html>
